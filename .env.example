# Vercel project environment variables
DATABASE_URL=            # Neon Postgres connection string (Vercel Marketplace > Neon)
RESEND_API_KEY=          # from resend.com
LEAD_FROM=               # e.g. "Taj Mahal Website <leads@iamtajmahal.com>" (domain must be verified in Resend)
LEAD_TO=                 # inbox(es) that get each new lead, comma separated
TEAM_EMAIL=              # login email for /team
TEAM_PASSWORD=           # login password for /team
SESSION_SECRET=          # long random string, signs the /team login cookie
